package = "braincloud"
version = "6.1.0-1"
source = {
	url = "git+https://github.com/getbraincloud/braincloud-lua.git",
	tag = "6.1.0",
}
description = {
	summary = "brainCloud client SDK for Lua (LÖVE, LuaJIT)",
	detailed = "Authentication, cloud data, leaderboards, lobbies, chat, real-time events and relay multiplayer for brainCloud.",
	homepage = "https://getbraincloud.com",
	license = "Apache-2.0",
}
dependencies = {
	"lua >= 5.1",
	"luasocket >= 3.0",
	"luasec >= 1.0",
}
build = {
	type = "builtin",
	modules = {
		["braincloud.client"] = "braincloud/client.lua",
		["braincloud"] = "braincloud/init.lua",
		["braincloud.lib.base64"] = "braincloud/lib/base64.lua",
		["braincloud.lib.bit"] = "braincloud/lib/bit.lua",
		["braincloud.lib.json"] = "braincloud/lib/json.lua",
		["braincloud.lib.luasec.https"] = "braincloud/lib/luasec/https.lua",
		["braincloud.lib.luasec.ssl"] = "braincloud/lib/luasec/ssl.lua",
		["braincloud.lib.md5"] = "braincloud/lib/md5.lua",
		["braincloud.lib.profile"] = "braincloud/lib/profile.lua",
		["braincloud.net.stream"] = "braincloud/net/stream.lua",
		["braincloud.net.websocket"] = "braincloud/net/websocket.lua",
		["braincloud.platform.core"] = "braincloud/platform/core.lua",
		["braincloud.platform.http"] = "braincloud/platform/http.lua",
		["braincloud.platform.native"] = "braincloud/platform/native.lua",
		["braincloud.reasoncodes"] = "braincloud/reasoncodes.lua",
		["braincloud.relay_comms"] = "braincloud/relay_comms.lua",
		["braincloud.rtt_comms"] = "braincloud/rtt_comms.lua",
		["braincloud.services.app_store"] = "braincloud/services/app_store.lua",
		["braincloud.services.async_match"] = "braincloud/services/async_match.lua",
		["braincloud.services.authentication"] = "braincloud/services/authentication.lua",
		["braincloud.services.blockchain"] = "braincloud/services/blockchain.lua",
		["braincloud.services.campaign"] = "braincloud/services/campaign.lua",
		["braincloud.services.chat"] = "braincloud/services/chat.lua",
		["braincloud.services.custom_entity"] = "braincloud/services/custom_entity.lua",
		["braincloud.services.data_stream"] = "braincloud/services/data_stream.lua",
		["braincloud.services.entity"] = "braincloud/services/entity.lua",
		["braincloud.services.event"] = "braincloud/services/event.lua",
		["braincloud.services.file"] = "braincloud/services/file.lua",
		["braincloud.services.friend"] = "braincloud/services/friend.lua",
		["braincloud.services.gamification"] = "braincloud/services/gamification.lua",
		["braincloud.services.global_app"] = "braincloud/services/global_app.lua",
		["braincloud.services.global_entity"] = "braincloud/services/global_entity.lua",
		["braincloud.services.global_file"] = "braincloud/services/global_file.lua",
		["braincloud.services.global_statistics"] = "braincloud/services/global_statistics.lua",
		["braincloud.services.group"] = "braincloud/services/group.lua",
		["braincloud.services.group_file"] = "braincloud/services/group_file.lua",
		["braincloud.services.identity"] = "braincloud/services/identity.lua",
		["braincloud.services.item_catalog"] = "braincloud/services/item_catalog.lua",
		["braincloud.services.leaderboard"] = "braincloud/services/leaderboard.lua",
		["braincloud.services.lobby"] = "braincloud/services/lobby.lua",
		["braincloud.services.mail"] = "braincloud/services/mail.lua",
		["braincloud.services.match_making"] = "braincloud/services/match_making.lua",
		["braincloud.services.messaging"] = "braincloud/services/messaging.lua",
		["braincloud.services.one_way_match"] = "braincloud/services/one_way_match.lua",
		["braincloud.services.playback_stream"] = "braincloud/services/playback_stream.lua",
		["braincloud.services.player_state"] = "braincloud/services/player_state.lua",
		["braincloud.services.player_statistics"] = "braincloud/services/player_statistics.lua",
		["braincloud.services.player_statistics_event"] = "braincloud/services/player_statistics_event.lua",
		["braincloud.services.presence"] = "braincloud/services/presence.lua",
		["braincloud.services.profanity"] = "braincloud/services/profanity.lua",
		["braincloud.services.push_notification"] = "braincloud/services/push_notification.lua",
		["braincloud.services.raw"] = "braincloud/services/raw.lua",
		["braincloud.services.redemption_code"] = "braincloud/services/redemption_code.lua",
		["braincloud.services.relay"] = "braincloud/services/relay.lua",
		["braincloud.services.rtt"] = "braincloud/services/rtt.lua",
		["braincloud.services.s3_handling"] = "braincloud/services/s3_handling.lua",
		["braincloud.services.script"] = "braincloud/services/script.lua",
		["braincloud.services.time"] = "braincloud/services/time.lua",
		["braincloud.services.tournament"] = "braincloud/services/tournament.lua",
		["braincloud.services.user_items"] = "braincloud/services/user_items.lua",
		["braincloud.services.virtual_currency"] = "braincloud/services/virtual_currency.lua",
		["braincloud.util"] = "braincloud/util.lua",
		["braincloud.version"] = "braincloud/version.lua",
		["braincloud.wrapper"] = "braincloud/wrapper.lua",
	},
}
